<!-- templates/create_trip.html -->
{% extends "base.html" %}
{% block title %}Create New Trip - Traveloop{% endblock %}
{% block content %}
<div class="row justify-content-center"><div class="col-md-8"><div class="card p-4"><h2 class="mb-4"><i class="fas fa-plus-circle me-2"></i>Plan a New Trip</h2>
<form method="POST"><div class="mb-3"><label class="form-label">Trip Name <span class="text-danger">*</span></label><input type="text" name="name" class="form-control" required placeholder="Summer Europe Tour"></div>
<div class="row"><div class="col-md-6 mb-3"><label class="form-label">Start Date</label><input type="date" name="start_date" class="form-control" required></div><div class="col-md-6 mb-3"><label class="form-label">End Date</label><input type="date" name="end_date" class="form-control" required></div></div>
<div class="mb-3"><label class="form-label">Description</label><textarea name="description" class="form-control" rows="3" placeholder="Describe your dream trip..."></textarea></div>
<div class="mb-3"><label class="form-label">Cover Photo URL (optional)</label><input type="text" name="cover_photo" class="form-control" placeholder="https://example.com/photo.jpg"></div>
<button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Create Trip & Continue Planning</button></form></div></div></div>
{% endblock %}